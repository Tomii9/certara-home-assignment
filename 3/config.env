# Shared configuration for scripts/dev.sh and scripts/dev.ps1.
# Plain KEY=VALUE pairs only (no quotes, no spaces around '=') so that both
# bash and PowerShell can parse it.
MINIKUBE_PROFILE=hello-rest
MINIKUBE_DRIVER=docker
MINIKUBE_CPUS=2
MINIKUBE_MEMORY=2048
KUBERNETES_VERSION=stable

APP_NAME=hello-rest
APP_NAMESPACE=hello-rest
APP_VERSION=1.0
APP_ZIP_URL=https://github.com/DawiX/rest-hw-dwnld/raw/refs/heads/main/rest_1.0.zip
APP_ZIP_SHA256=8747ca75c4deea2d4a14c3d217e69b7d430a43bedd734d7eb65b7f3f15564deb

REGISTRY_PORT=5000
LOCAL_PORT=8080
